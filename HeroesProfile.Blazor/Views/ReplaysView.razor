@page "/"
@inherits ReactiveInjectableComponentBase<ReplaysViewModel>

@if (ViewModel.StoredReplays != null)
{
    <Row>
        <Column>

            <DataGrid TItem=ReplaysViewModel.GridItem
                      Data=@ViewModel.StoredReplays
                      Filterable=true
                      PageSize=20
                      ShowPager=true
                      Virtualize=false
                      Responsive=true
                      Editable=false
                      Narrow=true
                      FilterMethod=DataGridFilterMethod.Contains>

                <!-- Name -->
                <DataGridColumn TItem="ReplaysViewModel.GridItem" Field="@nameof(ReplaysViewModel.GridItem.Path)" Caption="Name" SortField="Created" Sortable=true />

                <!-- Created -->
                <DataGridDateColumn TItem="ReplaysViewModel.GridItem" Field="@nameof(ReplaysViewModel.GridItem.Created)" Caption="Created" Sortable=true Displayable=true />

                <!-- Updated -->
                <DataGridDateColumn TItem="ReplaysViewModel.GridItem" Field="@nameof(ReplaysViewModel.GridItem.Updated)" Caption="Updated" />

                <!-- Process Status -->
                <DataGridNumericColumn Filterable=true TItem="ReplaysViewModel.GridItem" Field="@nameof(ReplaysViewModel.GridItem.ProcessStatus)" Caption="Process">
                    <DisplayTemplate>
                        <Badge Color=context.ProcessStatusColor>
                            @context.ProcessStatus
                        </Badge>
                    </DisplayTemplate>
                </DataGridNumericColumn>

                <!-- Parse Status -->
                <DataGridNumericColumn Filterable=true TItem="ReplaysViewModel.GridItem" Field="@nameof(ReplaysViewModel.GridItem.ParseStatus)" Caption="Parsing">
                    <DisplayTemplate>
                        <Badge Color=context.ParseStatusColor>
                            @context.ParseStatus
                        </Badge>
                    </DisplayTemplate>
                </DataGridNumericColumn>

                <!-- Launch Heroes with the .StormReplay -->
                <DataGridColumn Filterable=false TItem="ReplaysViewModel.GridItem" Field="@nameof(ReplaysViewModel.GridItem.Exists)" Caption="Launch">
                    <DisplayTemplate>
                        @if (!context.Exists)
                        {
                            <Badge Color=Color.Warning>No Local file</Badge>
                        }
                        else
                        {
                            <Button Size=Size.Small Color=Color.Primary @onclick="@context.LaunchReplay">Launch Replay</Button>
                        }
                    </DisplayTemplate>
                </DataGridColumn>

                <!-- Heroes Profile Web Link -->
                <DataGridColumn Filterable=false TItem="ReplaysViewModel.GridItem" Field="@nameof(ReplaysViewModel.GridItem.WebLink)" Caption="Web Link">
                    <DisplayTemplate>
                        @if (context.WebLink != null && context.ProcessStatus == ProcessStatus.Success)
                        {
                            <Button Size=Size.Small Color=Color.Primary @onclick="@context.OpenInBrowser">
                                Open in Browser
                            </Button>
                        }
                        else
                        {
                            <Badge Color=Color.Info>
                                No ReplayID
                            </Badge>
                        }
                    </DisplayTemplate>
                </DataGridColumn>

            </DataGrid>
        </Column>
    </Row>
}

@code {
    protected override async Task OnInitializedAsync() => await ViewModel!.LoadAsync(CancellationToken.None);
}